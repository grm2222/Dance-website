---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Хуудас олдсонгүй">
  <div class="mx-auto max-w-[560px] px-s4 py-s18 text-center">
    <p class="font-display text-hero font-normal text-accent-700" aria-hidden="true">404</p>
    <h1 class="mt-s4 font-display text-section font-normal text-ink-800">Хуудас олдсонгүй</h1>
    <p class="mt-s3 text-ink-600">
      Таны хайсан хуудас устгагдсан, нэр нь өөрчлөгдсөн эсвэл түр хугацаанд ашиглах боломжгүй
      байж магадгүй.
    </p>
    <div class="mt-s8 flex flex-col sm:flex-row gap-s3 justify-center">
      <a href="/" class="btn-primary">Нүүр хуудас руу буцах</a>
      <a
        href="/news"
        class="inline-flex items-center justify-center min-h-[var(--tap)] px-s6 py-s3 rounded-flat border border-line-strong text-nav font-bold uppercase tracking-[.04em] text-ink-800 hover:border-ink-800 hover:bg-paper-alt transition-colors"
      >
        Мэдээ үзэх
      </a>
    </div>
  </div>
</BaseLayout>

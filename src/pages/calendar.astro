---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventList from '../components/EventList.astro';
import { sanityFetch } from '../lib/sanity';
import { allUpcomingEventsQuery, allResultsQuery } from '../lib/queries';
import type { DanceEvent } from '../lib/types';

const [upcoming, results] = await Promise.all([
  sanityFetch<DanceEvent[]>(allUpcomingEventsQuery, []),
  sanityFetch<DanceEvent[]>(allResultsQuery, []),
]);
---

<BaseLayout
  title="Тэмцээний хуанли"
  description="Тэмцээний хуваарь болон үр дүн"
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:py-14">
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-10">Тэмцээний хуанли</h1>

    <section aria-labelledby="schedule-heading" class="mb-12">
      <h2 id="schedule-heading" class="text-xl sm:text-2xl font-bold text-title-600 mb-5">
        Тэмцээний хуваарь
      </h2>
      <EventList events={upcoming} emptyText="Одоогоор товлогдсон тэмцээн алга байна." />
    </section>

    <section aria-labelledby="results-heading">
      <h2 id="results-heading" class="text-xl sm:text-2xl font-bold text-title-600 mb-5">
        Тэмцээний үр дүн
      </h2>
      <EventList events={results} emptyText="Одоогоор үр дүн ороогүй байна." />
    </section>
  </div>
</BaseLayout>

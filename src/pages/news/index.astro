---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { sanityFetch } from '../../lib/sanity';
import { allNewsQuery, newsCategoriesQuery } from '../../lib/queries';
import type { NewsArticlePreview, NewsCategory } from '../../lib/types';

const [articles, categories] = await Promise.all([
  sanityFetch<NewsArticlePreview[]>(allNewsQuery, []),
  sanityFetch<NewsCategory[]>(newsCategoriesQuery, []),
]);
---

<BaseLayout title="Мэдээ мэдээлэл">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-6">Мэдээ мэдээлэл</h1>

    {
      categories.length > 0 && (
        <nav aria-label="Мэдээний ангилал" class="mb-8">
          <ul class="flex flex-wrap gap-2">
            <li>
              <span class="inline-block rounded-full bg-theme-600 text-white px-4 py-1.5 text-sm font-medium">
                Бүгд
              </span>
            </li>
            {categories.map((category) => (
              <li>
                <a
                  href={`/news/category/${category.slug}`}
                  class="inline-block rounded-full border border-gray-200 px-4 py-1.5 text-sm font-medium text-gray-700 hover:border-theme-600 hover:text-theme-600"
                >
                  {category.title.mn}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      articles.length === 0 ? (
        <p class="text-gray-500">Одоогоор мэдээ алга байна.</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

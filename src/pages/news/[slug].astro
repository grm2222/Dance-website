---
import NewsArticleView from '../../views/NewsArticleView.astro';
import { sanityFetch } from '../../lib/sanity';
import { newsArticleBySlugQuery } from '../../lib/queries';
import type { NewsArticle } from '../../lib/types';

// Rendered on demand and cached by ISR (see astro.config.mjs): a newly
// published item is reachable immediately, without a rebuild.
const { slug } = Astro.params;
const article = await sanityFetch<NewsArticle | null>(newsArticleBySlugQuery, null, { slug });

if (!article) {
  return Astro.redirect('/news');
}
---

<NewsArticleView article={article} />

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CategoryTabs from '../../../components/CategoryTabs.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { sanityFetch } from '../../../lib/sanity';
import { newsByCategoryQuery, newsCategoriesQuery } from '../../../lib/queries';
import { t } from '../../../lib/format';
import type { NewsArticlePreview, NewsCategory } from '../../../lib/types';

export async function getStaticPaths() {
  const categories = await sanityFetch<NewsCategory[]>(newsCategoriesQuery, []);
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, categories },
  }));
}

interface Props {
  category: NewsCategory;
  categories: NewsCategory[];
}

const { category, categories } = Astro.props;
const articles = await sanityFetch<NewsArticlePreview[]>(newsByCategoryQuery, [], {
  category: category.slug,
});
const title = t(category.title);
---

<BaseLayout title={title}>
  <PageHeader
    title={title}
    crumbs={[
      { label: 'Нүүр', href: '/' },
      { label: 'Мэдээ', href: '/news' },
    ]}
  />

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <CategoryTabs categories={categories} activeSlug={category.slug} />

    {
      articles.length === 0 ? (
        <p class="text-nav text-ink-600">Энэ ангилалд мэдээ алга байна.</p>
      ) : (
        <div class="grid gap-s6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

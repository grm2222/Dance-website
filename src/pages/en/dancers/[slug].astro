---
import DancerView from '../../../views/DancerView.astro';
import { sanityFetch } from '../../../lib/sanity';
import { dancerBySlugQuery } from '../../../lib/queries';
import type { Dancer } from '../../../lib/types';

// Rendered on demand and cached by ISR (see astro.config.mjs): a newly
// published item is reachable immediately, without a rebuild.
const { slug } = Astro.params;
const dancer = await sanityFetch<Dancer | null>(dancerBySlugQuery, null, { slug });

if (!dancer) {
  return Astro.redirect('/en/dancers');
}
---

<DancerView dancer={dancer} />

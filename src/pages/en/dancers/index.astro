---
import DancersView from '../../../views/DancersView.astro';
import { sanityFetch } from '../../../lib/sanity';
import { allDancersQuery } from '../../../lib/queries';
import { PER_PAGE } from '../../../lib/pagination';
import type { DancerPreview } from '../../../lib/types';

const dancers = await sanityFetch<DancerPreview[]>(allDancersQuery, []);
const totalPages = Math.max(1, Math.ceil(dancers.length / PER_PAGE));
---

<DancersView
  dancers={dancers.slice(0, PER_PAGE)}
  page={1}
  totalPages={totalPages}
  total={dancers.length}
/>

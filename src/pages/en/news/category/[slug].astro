---
import CategoryView from '../../../../views/CategoryView.astro';
import { sanityFetch } from '../../../../lib/sanity';
import { newsCategoriesQuery } from '../../../../lib/queries';
import type { NewsCategory } from '../../../../lib/types';

export async function getStaticPaths() {
  const categories = await sanityFetch<NewsCategory[]>(newsCategoriesQuery, []);
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, categories },
  }));
}

interface Props {
  category: NewsCategory;
  categories: NewsCategory[];
}

const { category, categories } = Astro.props;
---

<CategoryView category={category} categories={categories} />

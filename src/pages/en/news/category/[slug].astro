---
import CategoryView from '../../../../views/CategoryView.astro';
import { sanityFetch } from '../../../../lib/sanity';
import { newsCategoriesQuery } from '../../../../lib/queries';
import type { NewsCategory } from '../../../../lib/types';

// Rendered on demand and cached by ISR (see astro.config.mjs), so the category
// is resolved from the URL at request time. A new category is reachable as soon
// as it is published, without waiting for a rebuild.
const { slug } = Astro.params;
const categories = await sanityFetch<NewsCategory[]>(newsCategoriesQuery, []);
const category = categories.find((c) => c.slug === slug);

if (!category) {
  return Astro.redirect('/en/news');
}
---

<CategoryView category={category} categories={categories} />

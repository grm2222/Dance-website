---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RegistrationForm from '../../components/RegistrationForm.astro';
---

<BaseLayout
  title="Байгууллага, клубын бүртгэл"
  description="Байгууллага, клубын гишүүнчлэлийн бүртгэлийн хүсэлт илгээх"
>
  <div class="mx-auto max-w-2xl px-4 py-10 sm:py-14">
    <nav aria-label="Байршил" class="mb-4 text-sm text-body-500">
      <a href="/register" class="hover:text-theme-600">Бүртгэл</a>
      <span aria-hidden="true"> / </span>
      <span>Байгууллага, клуб</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-3">Байгууллага, клубын бүртгэл</h1>
    <p class="text-body-500 mb-8">
      Холбоонд гишүүнээр элсэх хүсэлтэй байгууллага, клубууд доорх маягтыг бөглөж илгээнэ үү.
    </p>
    <RegistrationForm />
  </div>
</BaseLayout>

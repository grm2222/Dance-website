---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DancerRegistrationForm from '../../components/DancerRegistrationForm.astro';

---

<BaseLayout title="Бүжигчний бүртгэл" description="Холбоонд тамирчин, бүжигчнээр бүртгүүлэх хүсэлтээ доорх маягтаар илгээнэ үү.">
  <PageHeader
    title="Бүжигчний бүртгэл"
    lead="Холбоонд тамирчин, бүжигчнээр бүртгүүлэх хүсэлтээ доорх маягтаар илгээнэ үү."
    crumbs={[
      { label: 'Нүүр', href: '/' },
      { label: 'Бүртгэл', href: '/register' },
    ]}
  />

  <div class="mx-auto max-w-[560px] px-s4 py-s12 md:py-s18">
    <DancerRegistrationForm />
  </div>
</BaseLayout>

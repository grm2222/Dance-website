---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RegistrationForm from '../components/RegistrationForm.astro';
import { sanityFetch } from '../lib/sanity';
import { pageContentQuery } from '../lib/queries';
import { t } from '../lib/format';
import { toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { PageContent } from '../lib/types';

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const page = await sanityFetch<PageContent | null>(pageContentQuery, null);

const title = t(page?.clubFormTitle, lang) || s.clubFormTitle;
const lead = t(page?.clubFormLead, lang) || s.clubFormLead;
const successMessage = t(page?.formSuccessMessage, lang) || s.formOk;
---

<BaseLayout title={title} description={lead}>
  <PageHeader
    title={title}
    lead={lead}
    crumbs={[
      { label: s.home, href: '/' },
      { label: t(page?.registerPageTitle, lang) || s.registration, href: '/register' },
    ]}
  />

  <div class="mx-auto max-w-[560px] px-s4 py-s12 md:py-s18">
    <RegistrationForm successMessage={successMessage} />
  </div>
</BaseLayout>

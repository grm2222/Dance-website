---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import NewsCard from '../components/NewsCard.astro';
import { sanityFetch } from '../lib/sanity';
import { allNewsQuery, newsCategoriesQuery } from '../lib/queries';
import { toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { NewsArticlePreview, NewsCategory } from '../lib/types';

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const [articles, categories] = await Promise.all([
  sanityFetch<NewsArticlePreview[]>(allNewsQuery, []),
  sanityFetch<NewsCategory[]>(newsCategoriesQuery, []),
]);
---

<BaseLayout title={s.newsTitle}>
  <PageHeader title={s.newsTitle} crumbs={[{ label: s.home, href: '/' }]} />

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <CategoryTabs categories={categories} />

    {
      articles.length === 0 ? (
        <p class="text-nav text-ink-600">{s.noNews}</p>
      ) : (
        <div class="grid gap-s6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

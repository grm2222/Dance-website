---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockTitle from '../components/BlockTitle.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import EventList from '../components/EventList.astro';
import Gallery from '../components/Gallery.astro';
import RegisterCards from '../components/RegisterCards.astro';
import { sanityFetch } from '../lib/sanity';
import {
  latestNewsQuery,
  upcomingEventsQuery,
  recentResultsQuery,
  galleryQuery,
  siteSettingsQuery,
  pageContentQuery,
} from '../lib/queries';
import { t } from '../lib/format';
import { localizePath, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type {
  DanceEvent,
  GalleryImage,
  NewsArticlePreview,
  PageContent,
  SiteSettings,
} from '../lib/types';

// Rendered by both /  and /en/ — the locale comes from the URL via
// Astro.currentLocale, so the body is written once.
const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const [settings, page, latestNews, upcomingEvents, recentResults, galleryImages] =
  await Promise.all([
    sanityFetch<SiteSettings | null>(siteSettingsQuery, null),
    sanityFetch<PageContent | null>(pageContentQuery, null),
    sanityFetch<NewsArticlePreview[]>(latestNewsQuery, []),
    sanityFetch<DanceEvent[]>(upcomingEventsQuery, []),
    sanityFetch<DanceEvent[]>(recentResultsQuery, []),
    sanityFetch<GalleryImage[]>(galleryQuery, []),
  ]);

const siteName = t(settings?.siteName, lang) || s.siteNameFallback;
const aboutText = t(page?.aboutText, lang);
const showHero = page?.showHero !== false;

// Admin-controlled headings and section sizes; each falls back to the built-in
// translation so a blank field never leaves a heading empty.
const newsHeading = t(page?.newsHeading, lang) || s.latestNews;
const scheduleHeading = t(page?.scheduleHeading, lang) || s.schedule;
const resultsHeading = t(page?.resultsHeading, lang) || s.results;
const galleryHeading = t(page?.galleryHeading, lang) || s.gallery;
const registerHeading = t(page?.registerHeading, lang) || s.registration;

const newsCount = page?.newsCount ?? 3;
const galleryCount = page?.galleryCount ?? 8;
const showGallery = page?.showGallery !== false && galleryImages.length > 0;
const showRegister = page?.showRegisterSection !== false;
---

<BaseLayout title={siteName}>
  {/* The hero used to carry this page's only <h1>. It is kept visually hidden
      so the document still has a top-level heading for screen readers and
      search engines — every page needs exactly one. */}
  <h1 class="sr-only">{siteName}</h1>

  {showHero && <Hero page={page} />}

  <!-- ═══ Latest news ═══ -->
  <section class="py-s12 md:py-s18" aria-labelledby="news-heading">
    <div class="mx-auto max-w-page px-s4">
      <BlockTitle id="news-heading" title={newsHeading} moreHref={localizePath('/news', lang)} />
      {
        latestNews.length === 0 ? (
          <p class="text-nav text-ink-600">{t(page?.newsEmpty, lang) || s.noNews}</p>
        ) : (
          <div class="grid gap-s6 sm:grid-cols-2 lg:grid-cols-3">
            {latestNews.slice(0, newsCount).map((article) => (
              <NewsCard article={article} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ═══ Calendar: upcoming + results side by side ═══ -->
  <section class="bg-paper-alt border-y border-line py-s12 md:py-s18" aria-labelledby="events-heading">
    <h2 id="events-heading" class="sr-only">{s.competitionInfo}</h2>
    <div class="mx-auto max-w-page px-s4 grid gap-s12 lg:grid-cols-2 lg:gap-s8">
      <div>
        <BlockTitle as="h3" title={scheduleHeading} moreHref={localizePath('/calendar', lang)} />
        <EventList
          events={upcomingEvents}
          emptyText={t(page?.scheduleEmpty, lang) || s.noUpcoming}
          compact
        />
      </div>
      <div>
        <BlockTitle as="h3" title={resultsHeading} moreHref={`${localizePath('/calendar', lang)}#results`} />
        <EventList
          events={recentResults}
          emptyText={t(page?.resultsEmpty, lang) || s.noResults}
          compact
        />
      </div>
    </div>
  </section>

  <!-- ═══ Gallery ═══ -->
  {
    showGallery && (
      <section class="py-s12 md:py-s18" aria-labelledby="gallery-heading">
        <div class="mx-auto max-w-page px-s4">
          <BlockTitle id="gallery-heading" title={galleryHeading} />
          <Gallery images={galleryImages.slice(0, galleryCount)} />
        </div>
      </section>
    )
  }

  <!-- ═══ About ═══ -->
  {
    aboutText && (
      <section class="py-s12 md:py-s18 border-t border-line" aria-labelledby="about-heading">
        <div class="mx-auto max-w-page px-s4">
          <BlockTitle id="about-heading" title={t(page?.aboutTitle, lang) || s.aboutUs} />
          <p class="max-w-[70ch] whitespace-pre-line leading-[1.75]">{aboutText}</p>
        </div>
      </section>
    )
  }

  <!-- ═══ Registration ═══ -->
  {
    showRegister && (
      <section class="bg-paper-alt border-y border-line py-s12 md:py-s18" aria-labelledby="register-heading">
        <div class="mx-auto max-w-page px-s4">
          <BlockTitle id="register-heading" title={registerHeading} />
          <RegisterCards page={page} />
        </div>
      </section>
    )
  }
</BaseLayout>

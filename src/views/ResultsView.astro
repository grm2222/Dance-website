---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventList from '../components/EventList.astro';
import { sanityFetch } from '../lib/sanity';
import { allResultsQuery, pageContentQuery } from '../lib/queries';
import { t } from '../lib/format';
import { localizePath, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { DanceEvent, PageContent } from '../lib/types';

// Finished competitions and their placings. Upcoming ones live on the
// calendar page — see CalendarView.astro.
const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const [page, results] = await Promise.all([
  sanityFetch<PageContent | null>(pageContentQuery, null),
  sanityFetch<DanceEvent[]>(allResultsQuery, []),
]);

const title = t(page?.resultsPageTitle, lang) || s.resultsTitle;
const lead = t(page?.resultsPageLead, lang) || s.resultsLead;
const calendarLabel = t(page?.calendarPageTitle, lang) || s.calendarTitle;
---

<BaseLayout title={title} description={lead}>
  <PageHeader title={title} lead={lead} crumbs={[{ label: s.home, href: '/' }]} />

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <EventList
      events={results}
      emptyText={t(page?.resultsEmpty, lang) || s.noResults}
      resultHref=""
    />

    <p class="mt-s8">
      <a
        href={localizePath('/calendar', lang)}
        class="tap inline-flex items-center text-nav font-bold text-ink-800 hover:text-accent-700 transition-colors"
      >
        {calendarLabel} →
      </a>
    </p>
  </div>
</BaseLayout>

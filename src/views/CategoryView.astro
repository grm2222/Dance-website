---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import NewsCard from '../components/NewsCard.astro';
import { sanityFetch } from '../lib/sanity';
import { newsByCategoryQuery, pageContentQuery } from '../lib/queries';
import { t } from '../lib/format';
import { toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { NewsArticlePreview, NewsCategory, PageContent } from '../lib/types';

interface Props {
  category: NewsCategory;
  categories: NewsCategory[];
}

const { category, categories } = Astro.props;

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const [page, articles] = await Promise.all([
  sanityFetch<PageContent | null>(pageContentQuery, null),
  sanityFetch<NewsArticlePreview[]>(newsByCategoryQuery, [], { category: category.slug }),
]);
const title = t(category.title, lang);
---

<BaseLayout title={title}>
  <PageHeader
    title={title}
    crumbs={[
      { label: s.home, href: '/' },
      { label: s.navNews, href: '/news' },
    ]}
  />

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <CategoryTabs categories={categories} activeSlug={category.slug} />

    {
      articles.length === 0 ? (
        <p class="text-nav text-ink-600">{t(page?.categoryEmpty, lang) || s.noNewsInCategory}</p>
      ) : (
        <div class="grid gap-s6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

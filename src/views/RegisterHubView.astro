---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RegisterCards from '../components/RegisterCards.astro';
import { sanityFetch } from '../lib/sanity';
import { pageContentQuery } from '../lib/queries';
import { t } from '../lib/format';
import { toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { PageContent } from '../lib/types';

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const page = await sanityFetch<PageContent | null>(pageContentQuery, null);

const title = t(page?.registerPageTitle, lang) || s.registration;
const lead = t(page?.registerLead, lang) || s.registerLead;
---

<BaseLayout title={title} description={lead}>
  <PageHeader title={title} lead={lead} crumbs={[{ label: s.home, href: '/' }]} />

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <RegisterCards page={page} />
  </div>
</BaseLayout>

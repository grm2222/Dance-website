---
import { urlFor } from '../lib/sanity';
import { daysUntil, formatDate, formatLongDate, t } from '../lib/format';
import { alternatePath, LANG_LABELS, localizePath, LOCALES, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { DanceEvent, NavItem, SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings | null;
  /** Next scheduled competition, for the logo-band strip. */
  nextEvent?: DanceEvent | null;
}

const { settings, nextEvent = null } = Astro.props;

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const siteName = t(settings?.siteName, lang) || s.siteNameFallback;
const tagline = t(settings?.tagline, lang);
const logoUrl = settings?.logo ? urlFor(settings.logo).width(104).height(104).url() : null;
const phone = settings?.phone;
const email = settings?.emails?.[0];

// Falls back to the Phase 1 routes that actually exist. Admins replace this
// in Sanity → Site settings → Menu; see docs/design-wdc.md §2.
const FALLBACK_NAV: NavItem[] = [
  { label: { mn: 'Мэдээ', en: 'News' }, href: '/news' },
  { label: { mn: 'Хуанли', en: 'Calendar' }, href: '/calendar' },
  {
    label: { mn: 'Бүртгэл', en: 'Register' },
    href: '/register',
    children: [
      { label: { mn: 'Клуб бүртгүүлэх', en: 'Register a club' }, href: '/register/club' },
      { label: { mn: 'Тамирчин бүртгүүлэх', en: 'Register a dancer' }, href: '/register/dancer' },
    ],
  },
];
const navItems = settings?.navigation?.length ? settings.navigation : FALLBACK_NAV;

const currentPath = Astro.url.pathname;

/** Internal links get the /en prefix; external ones are left alone. */
const href = (target: string) =>
  target.startsWith('/') ? localizePath(target, lang) : target;

const isActive = (target: string) => {
  const resolved = href(target);
  if (!resolved.startsWith('/')) return false;
  const base = resolved.replace(/\/$/, '') || '/';
  return base === '/' ? currentPath.replace(/\/$/, '') === '' || currentPath === '/' : currentPath.startsWith(base);
};

const socials = [
  { url: settings?.facebookUrl, label: 'Facebook', path: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z' },
  { url: settings?.instagramUrl, label: 'Instagram', path: 'M12 2c2.7 0 3 0 4.1.1 1.1 0 1.8.2 2.4.5.7.2 1.2.6 1.7 1.1s.9 1 1.1 1.7c.3.6.4 1.3.5 2.4C22 8.9 22 9.3 22 12s0 3.1-.1 4.2c0 1.1-.2 1.8-.5 2.4-.2.7-.6 1.2-1.1 1.7s-1 .9-1.7 1.1c-.6.3-1.3.4-2.4.5-1.1.1-1.4.1-4.2.1s-3.1 0-4.2-.1c-1.1 0-1.8-.2-2.4-.5-.7-.2-1.2-.6-1.7-1.1s-.9-1-1.1-1.7c-.3-.6-.4-1.3-.5-2.4C2 15.1 2 14.7 2 12s0-3.1.1-4.2c0-1.1.2-1.8.5-2.4.2-.7.6-1.2 1.1-1.7s1-.9 1.7-1.1c.6-.3 1.3-.4 2.4-.5C8.9 2 9.3 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm0 8.2a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4zM17.8 7.4a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z' },
  { url: settings?.youtubeUrl, label: 'YouTube', path: 'M21.6 7.2s-.2-1.4-.8-2c-.7-.8-1.5-.8-1.9-.8C16.2 4.2 12 4.2 12 4.2s-4.2 0-6.9.2c-.4 0-1.2 0-1.9.8-.6.6-.8 2-.8 2S2.2 8.8 2.2 10.5v1.6c0 1.6.2 3.3.2 3.3s.2 1.4.8 2c.7.8 1.7.7 2.1.8 1.5.2 6.7.2 6.7.2s4.2 0 6.9-.2c.4 0 1.2 0 1.9-.8.6-.6.8-2 .8-2s.2-1.6.2-3.3v-1.6c0-1.7-.2-3.3-.2-3.3zM9.9 14.3V8.6l5.4 2.9-5.4 2.8z' },
].filter((x): x is { url: string; label: string; path: string } => Boolean(x.url));

const todayLabel = formatLongDate(new Date(), lang);
const nextEventDays = nextEvent ? daysUntil(nextEvent.date) : 0;

// The same page in the other language, so switching keeps the reader in place.
const langLinks = LOCALES.map((code) => ({
  code,
  label: LANG_LABELS[code].short,
  full: LANG_LABELS[code].full,
  href: code === lang ? currentPath : alternatePath(currentPath, lang),
  current: code === lang,
}));
---

<header data-scrolled="false">
  <!-- ═══ 1. Utility bar ═══ -->
  <div class="bg-ink-700 text-white/70 text-meta">
    <div class="mx-auto max-w-page px-s4 min-h-[40px] flex items-center gap-s6">
      <span class="hidden md:inline whitespace-nowrap tracking-[.02em]">{todayLabel}</span>
      <ul class="hidden md:flex gap-s6">
        {phone && <li><a href={`tel:${phone}`} class="tap hover:text-white">{phone}</a></li>}
        {email && <li><a href={`mailto:${email}`} class="tap hover:text-white">{email}</a></li>}
      </ul>
      <div class="ml-auto max-md:ml-0 max-md:w-full flex items-center gap-s4 max-md:justify-between">
        <!-- Language selector: real links to the same page in the other language,
             so it works without JS and each language stays a crawlable URL. -->
        <nav aria-label={s.selectLanguage}>
          <ul class="flex items-center rounded-flat border border-white/25">
            {
              langLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    hreflang={link.code}
                    lang={link.code}
                    aria-current={link.current ? 'true' : undefined}
                    class:list={[
                      'tap block px-s3 py-s1 text-meta font-bold tracking-[.04em] rounded-[1px] transition-colors',
                      link.current ? 'bg-accent-700 text-white' : 'text-white/60 hover:text-white',
                    ]}
                  >
                    <span class="sr-only">{link.full}</span>
                    <span aria-hidden="true">{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          socials.length > 0 && (
            <div class="flex gap-s2">
              {socials.map((social) => (
                <a
                  href={social.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={social.label}
                  class="tap grid h-6 w-6 place-items-center rounded-flat bg-white/10 hover:bg-accent-700 hover:text-white transition-colors"
                >
                  <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current" aria-hidden="true"><path d={social.path} /></svg>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- ═══ 2. Logo band — desktop only; below 1024px the menu bar carries the brand ═══ -->
  <div class="bg-ink-900 max-lg:hidden" id="logo-band">
    <div class="mx-auto max-w-page px-s4 min-h-[96px] flex items-center gap-s4">
      <a href={href("/")} class="flex items-center gap-s4">
        {
          logoUrl ? (
            <img src={logoUrl} alt="" width="52" height="52" class="h-[52px] w-[52px] rounded-full object-cover" />
          ) : (
            <span aria-hidden="true" class="h-[52px] w-[52px] rounded-full bg-accent-700 text-white grid place-items-center font-display text-num font-medium">
              {siteName.charAt(0)}
            </span>
          )
        }
        <span class="font-display text-white text-head font-medium leading-tight">
          {siteName}
          {tagline && <small class="block font-sans text-meta font-normal tracking-[.1em] uppercase text-white/45 mt-s1">{tagline}</small>}
        </span>
      </a>

      {
        nextEvent && (
          <a
            href={href("/calendar")}
            class="ml-auto max-xl:hidden flex items-center gap-s3 py-s3 px-s4 border-l-[3px] border-accent-500 bg-white/[.04] rounded-flat hover:bg-white/[.08] transition-colors"
          >
            <span>
              <span class="block text-meta tracking-[.1em] uppercase text-white/50 mb-s1">{s.nextCompetition}</span>
              <span class="block font-display text-nav text-white">
                {t(nextEvent.title, lang)} · {formatDate(nextEvent.date, lang)}
              </span>
            </span>
            <span class="shrink-0 text-center pl-s4 border-l border-white/10">
              <b class="block font-display text-num text-white font-medium leading-none">{Math.max(nextEventDays, 0)}</b>
              <span class="text-meta text-white/50 uppercase">{s.days}</span>
            </span>
          </a>
        )
      }
    </div>
  </div>

  <!-- ═══ 3. Menu bar — sticky; dark below 1024px where it replaces the logo band ═══ -->
  <div class="sticky top-0 z-50 bg-paper max-lg:bg-ink-900 border-b border-line max-lg:border-b-0 shadow-[0_1px_3px_rgb(0_0_0/0.08)]">
    <div class="mx-auto max-w-page px-s4 min-h-[56px] flex items-center">
      <!-- Compact mark: always shown on mobile; on desktop it appears only once
           the logo band has scrolled away, so the brand never renders twice.
           Visibility is driven by data-scrolled on <header> (see the style block
           below) rather than by utility classes, because while hidden it must
           take up no layout space — otherwise it pushes the nav off its origin. -->
      <a href={href("/")} id="menu-mark" class="menu-mark items-center gap-s3 min-h-[var(--tap)] transition-opacity">
        <span aria-hidden="true" class="h-[34px] w-[34px] shrink-0 rounded-full bg-accent-700 text-white grid place-items-center font-display text-head font-medium">
          {siteName.charAt(0)}
        </span>
        <span class="text-nav font-bold leading-tight text-ink-800 max-lg:text-white">{siteName}</span>
      </a>

      <nav aria-label={s.mainMenu} class="max-lg:hidden self-stretch">
        <ul class="flex h-full">
          {
            navItems.map((item) => (
              <li class="relative flex group">
                {item.children?.length ? (
                  <button
                    type="button"
                    aria-expanded="false"
                    class="flex items-center gap-s1 px-s4 text-nav font-bold uppercase tracking-[.03em] text-ink-800 border-b-[3px] border-transparent hover:text-accent-700 transition-colors"
                  >
                    <span>{t(item.label, lang)}</span>
                    <svg viewBox="0 0 12 12" class="h-[9px] w-[9px] fill-current transition-transform" aria-hidden="true"><path d="M2 4l4 4 4-4z" /></svg>
                  </button>
                ) : (
                  <a
                    href={href(item.href)}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-center px-s4 text-nav font-bold uppercase tracking-[.03em] border-b-[3px] transition-colors',
                      isActive(item.href)
                        ? 'text-accent-700 border-accent-500'
                        : 'text-ink-800 border-transparent hover:text-accent-700',
                    ]}
                  >
                    {t(item.label, lang)}
                  </a>
                )}

                {item.children?.length ? (
                  <ul class="absolute top-full left-0 min-w-[240px] bg-paper border border-line border-t-[3px] border-t-accent-500 shadow-[0_6px_18px_rgb(0_0_0/0.1)] opacity-0 invisible -translate-y-1 transition-[opacity,transform,visibility] group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={href(child.href)}
                          class="block px-s4 py-s3 text-nav text-body border-b border-line last:border-b-0 hover:bg-paper-alt hover:text-accent-700 transition-colors"
                        >
                          {t(child.label, lang)}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-s1">
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden grid h-[var(--tap)] w-[var(--tap)] place-items-center rounded-flat hover:bg-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={s.openMenu}
        >
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-none stroke-white stroke-2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ Mobile panel — full screen, accordion, focus-trapped ═══ -->
  <div id="mobile-menu" data-open="false" class="fixed inset-0 z-[100] bg-paper hidden flex-col overflow-y-auto lg:!hidden">
    <div class="min-h-[56px] shrink-0 flex items-center justify-between px-s4 bg-ink-900 text-white">
      <span class="flex items-center gap-s3">
        <span aria-hidden="true" class="h-[34px] w-[34px] rounded-full bg-accent-700 grid place-items-center font-display text-head font-medium">
          {siteName.charAt(0)}
        </span>
        <span class="text-nav font-bold">{siteName}</span>
      </span>
      <button
        type="button"
        id="menu-close"
        class="grid h-[var(--tap)] w-[var(--tap)] place-items-center rounded-flat hover:bg-white/10"
        aria-label={s.closeMenu}
      >
        <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-none stroke-white stroke-2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <nav aria-label={s.mainMenu}>
      <ul class="pb-s8">
        {
          navItems.map((item) => (
            <li class="border-b border-line" data-open="false">
              {item.children?.length ? (
                <>
                  <button
                    type="button"
                    aria-expanded="false"
                    class="m-sub-toggle w-full min-h-[56px] flex items-center justify-between px-s4 text-copy font-bold uppercase tracking-[.03em] text-ink-800"
                  >
                    <span>{t(item.label, lang)}</span>
                    <svg viewBox="0 0 12 12" class="h-[9px] w-[9px] fill-current transition-transform" aria-hidden="true"><path d="M2 4l4 4 4-4z" /></svg>
                  </button>
                  <div class="m-sub hidden bg-paper-alt border-t border-line">
                    <a href={href(item.href)} class="flex items-center min-h-[var(--tap)] py-s3 pl-s8 pr-s4 text-copy text-body border-b border-line">
                      {t(item.label, lang)}
                    </a>
                    {item.children.map((child) => (
                      <a href={href(child.href)} class="flex items-center min-h-[var(--tap)] py-s3 pl-s8 pr-s4 text-copy text-body border-b border-line last:border-b-0">
                        {t(child.label, lang)}
                      </a>
                    ))}
                  </div>
                </>
              ) : (
                <a
                  href={href(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'w-full min-h-[56px] flex items-center px-s4 text-copy font-bold uppercase tracking-[.03em]',
                    isActive(item.href) ? 'text-accent-700' : 'text-ink-800',
                  ]}
                >
                  {t(item.label, lang)}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Below 1024px the compact mark IS the brand — the logo band is gone. */
  .menu-mark {
    display: flex;
  }
  @media (min-width: 1024px) {
    /* display:none, not opacity:0 — an invisible flex child still occupies
       space and would shift the nav sideways at the top of the page. */
    .menu-mark {
      display: none;
    }
    header[data-scrolled='true'] .menu-mark {
      display: flex;
    }
  }
</style>

<script>
  const panel = document.getElementById('mobile-menu');
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const mark = document.getElementById('menu-mark');
  const band = document.getElementById('logo-band');

  function setPanel(open: boolean) {
    if (!panel || !toggle) return;
    panel.dataset.open = String(open);
    panel.classList.toggle('hidden', !open);
    panel.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) close?.focus();
    else toggle.focus();
  }

  toggle?.addEventListener('click', () => setPanel(true));
  close?.addEventListener('click', () => setPanel(false));

  // Accordion inside the panel — expands in place, no second screen to go back from.
  document.querySelectorAll<HTMLButtonElement>('.m-sub-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.parentElement;
      const sub = li?.querySelector('.m-sub');
      if (!li || !sub) return;
      const open = li.dataset.open === 'true';
      li.dataset.open = String(!open);
      sub.classList.toggle('hidden', open);
      btn.setAttribute('aria-expanded', String(!open));
      btn.querySelector('svg')?.classList.toggle('rotate-180', !open);
    });
  });

  // Desktop dropdowns open on hover via CSS; this adds click/Enter so they are
  // reachable by keyboard, which hover-only menus are not.
  document.querySelectorAll<HTMLButtonElement>('nav[aria-label] > ul > li > button').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const li = btn.parentElement;
      const menu = li?.querySelector('ul');
      if (!menu) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('opacity-100', !open);
      menu.classList.toggle('visible', !open);
      btn.querySelector('svg')?.classList.toggle('rotate-180', !open);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openBtn = document.querySelector<HTMLButtonElement>(
      'nav[aria-label] > ul > li > button[aria-expanded="true"]',
    );
    if (openBtn) {
      openBtn.click();
      openBtn.focus();
      return;
    }
    if (panel?.dataset.open === 'true') setPanel(false);
  });

  // Trap focus while the panel is open.
  panel?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = panel.querySelectorAll<HTMLElement>('a[href], button');
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Above 1024px the panel is hidden by CSS — also release the scroll lock,
  // otherwise resizing while it is open leaves the page unscrollable.
  matchMedia('(min-width:1024px)').addEventListener('change', (e) => {
    if (e.matches && panel?.dataset.open === 'true') setPanel(false);
  });

  // Reveal the compact mark only once the logo band has left the viewport.
  const header = document.querySelector('header[data-scrolled]') as HTMLElement | null;
  if (band && mark && header) {
    new IntersectionObserver(
      ([entry]) => {
        header.dataset.scrolled = String(!entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(band);
  }
</script>

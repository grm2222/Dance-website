---
import { urlFor } from '../lib/sanity';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName?.mn ?? 'Монголын Чөлөөт Бүжгийн Холбоо';
const logoUrl = settings?.logo ? urlFor(settings.logo).width(96).height(96).url() : null;
const phone = settings?.phone;
const email = settings?.emails?.[0];

// Admin panel (Sanity Studio); set PUBLIC_STUDIO_URL after `sanity deploy`
const studioUrl = (import.meta.env.PUBLIC_STUDIO_URL as string | undefined) || 'http://localhost:3333';

const navItems = [
  { href: '/', label: 'Нүүр' },
  { href: '/news', label: 'Мэдээ' },
  { href: '/register', label: 'Бүртгүүлэх' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-40 bg-white shadow-sm">
  <!-- Top bar: contacts + register/login, as on the reference site -->
  <div class="bg-dark-800 text-white text-xs">
    <div class="mx-auto max-w-6xl px-4 h-9 flex items-center justify-between gap-4">
      <div class="hidden sm:flex items-center gap-4 min-w-0">
        {
          phone && (
            <a href={`tel:${phone}`} class="flex items-center gap-1.5 hover:text-theme-100 truncate">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.07 21 3 13.93 3 5a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
              </svg>
              {phone}
            </a>
          )
        }
        {
          email && (
            <a href={`mailto:${email}`} class="flex items-center gap-1.5 hover:text-theme-100 truncate">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
              </svg>
              {email}
            </a>
          )
        }
      </div>
      <div class="flex items-center gap-4 ml-auto">
        <a href="/register" class="font-semibold hover:text-theme-100">Бүртгүүлэх</a>
        <span aria-hidden="true" class="text-white/30">|</span>
        <a href={studioUrl} class="font-semibold hover:text-theme-100">Нэвтрэх</a>
        {
          settings?.facebookUrl && (
            <a
              href={settings.facebookUrl}
              rel="noopener noreferrer"
              target="_blank"
              aria-label="Facebook хуудас"
              class="grid h-5 w-5 place-items-center rounded-sm bg-white/10 hover:bg-theme-600 font-bold"
            >
              f
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Main bar: logo + navigation -->
  <div class="mx-auto max-w-6xl px-4 flex items-center justify-between gap-4 h-16">
    <a href="/" class="flex items-center gap-3 min-w-0">
      {
        logoUrl ? (
          <img src={logoUrl} alt="" width="40" height="40" class="h-10 w-10 rounded-full object-cover" />
        ) : (
          <span aria-hidden="true" class="h-10 w-10 rounded-full bg-theme-600 text-white grid place-items-center font-bold">
            Б
          </span>
        )
      }
      <span class="font-bold leading-tight text-sm sm:text-base truncate text-dark-800">{siteName}</span>
    </a>

    <nav aria-label="Үндсэн цэс" class="hidden sm:block">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'px-3 py-2 rounded-md text-sm font-semibold transition-colors',
                  isActive(item.href)
                    ? 'text-theme-600'
                    : 'text-dark-800 hover:text-theme-600',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="sm:hidden grid h-11 w-11 place-items-center rounded-md text-dark-800 hover:bg-smoke-100"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Цэс нээх"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Үндсэн цэс" class="sm:hidden hidden border-t border-smoke-100">
    <ul class="px-4 py-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block px-3 py-3 rounded-md text-base font-semibold',
                isActive(item.href) ? 'text-theme-600' : 'text-dark-800 hover:bg-smoke-100',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={studioUrl} class="block px-3 py-3 rounded-md text-base font-semibold text-dark-800 hover:bg-smoke-100">
          Нэвтрэх
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Close on Escape and return focus to the toggle button
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Close when tapping outside the header
  document.addEventListener('click', (e) => {
    if (menu && !menu.classList.contains('hidden') && e.target instanceof Node) {
      const header = menu.closest('header');
      if (header && !header.contains(e.target)) setOpen(false);
    }
  });
</script>

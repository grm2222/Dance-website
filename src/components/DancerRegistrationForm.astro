---
import { toLang } from '../lib/i18n';
import { strings } from '../lib/ui';

interface Props {
  /** Admin-editable thank-you text; falls back to the built-in translation. */
  successMessage?: string;
}

// Posts to our own endpoint only; the Sanity write token stays server-side.
const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const { successMessage = s.formOk } = Astro.props;
---

<form
  id="dancer-form"
  data-msg-ok={successMessage}
  data-msg-error={s.formError}
  data-msg-network={s.formNetworkError}
  method="post"
  action="/api/register-dancer"
  class="space-y-5"
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="lastName" class="field-label">
        {s.fieldLastName} <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        required
        maxlength="100"
        autocomplete="family-name"
        class="field-input"
      />
    </div>
    <div>
      <label for="firstName" class="field-label">
        {s.fieldFirstName} <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="firstName"
        name="firstName"
        required
        maxlength="100"
        autocomplete="given-name"
        class="field-input"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="birthDate" class="field-label">
        {s.fieldBirthDate} <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="date"
        id="birthDate"
        name="birthDate"
        required
        autocomplete="bday"
        class="field-input"
      />
    </div>
    <fieldset>
      <legend class="field-label">
        {s.fieldGender} <span class="field-req" aria-hidden="true">*</span>
      </legend>
      <div class="flex gap-6 pt-2.5">
        <label class="flex items-center gap-2 text-sm">
          <input type="radio" name="gender" value="male" required class="accent-[var(--color-accent-700)] h-4 w-4" />
          {s.genderMale}
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="radio" name="gender" value="female" class="accent-[var(--color-accent-700)] h-4 w-4" />
          {s.genderFemale}
        </label>
      </div>
    </fieldset>
  </div>

  <div>
    <label for="club" class="field-label">{s.fieldClub}</label>
    <input
      type="text"
      id="club"
      name="club"
      maxlength="200"
      placeholder={s.fieldClubPlaceholder}
      class="field-input"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="phone" class="field-label">
        {s.fieldPhone} <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        maxlength="30"
        autocomplete="tel"
        class="field-input"
      />
    </div>
    <div>
      <label for="email" class="field-label">
        {s.fieldEmail} <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="200"
        autocomplete="email"
        class="field-input"
      />
    </div>
  </div>

  <!-- Honeypot: hidden from humans, bots tend to fill it -->
  <div class="hidden" aria-hidden="true">
    <label for="dancer-website">{s.fieldWebsite}</label>
    <input type="text" id="dancer-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <p
    id="dancer-form-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
    class="hidden form-status"
  >
  </p>

  <button
    type="submit"
    id="dancer-form-submit"
    class="btn-primary w-full sm:w-auto"
  >
    {s.submitForm}
  </button>
</form>

<script>
  const form = document.getElementById('dancer-form') as HTMLFormElement | null;
  const status = document.getElementById('dancer-form-status');
  const submit = document.getElementById('dancer-form-submit') as HTMLButtonElement | null;

  // Status text is translated server-side and handed over on the form element.
  const msg = {
    ok: form?.dataset.msgOk ?? '',
    error: form?.dataset.msgError ?? '',
    network: form?.dataset.msgNetwork ?? '',
  };

  function showStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'form-status-ok', 'form-status-error');
    status.classList.add(ok ? 'form-status-ok' : 'form-status-error');
    status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    status.focus({ preventScroll: true });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (submit) submit.disabled = true;

    try {
      const res = await fetch('/api/register-dancer', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = (await res.json()) as { ok: boolean; error?: string };
      if (res.ok && data.ok) {
        form.reset();
        showStatus(msg.ok, true);
      } else {
        showStatus(data.error ?? msg.error, false);
      }
    } catch {
      showStatus(msg.network, false);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

---

// Posts to our own endpoint only; the Sanity write token stays server-side.
---

<form
  id="registration-form"
  method="post"
  action="/api/register"
  class="space-y-5"
  novalidate
>
  <div>
    <label for="orgName" class="field-label">
      Байгууллага / клубын нэр <span class="field-req" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="orgName"
      name="orgName"
      required
      maxlength="200"
      autocomplete="organization"
      class="field-input"
    />
  </div>

  <div>
    <label for="about" class="field-label">
      Танилцуулга <span class="field-req" aria-hidden="true">*</span>
    </label>
    <textarea
      id="about"
      name="about"
      required
      rows="4"
      maxlength="2000"
      class="field-input"
      placeholder="Үйл ажиллагааныхаа талаар товч бичнэ үү"></textarea>
  </div>

  <div>
    <label for="address" class="field-label">
      Хаяг <span class="field-req" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="address"
      name="address"
      required
      maxlength="300"
      autocomplete="street-address"
      class="field-input"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="phone" class="field-label">
        Утасны дугаар <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        maxlength="30"
        autocomplete="tel"
        class="field-input"
      />
    </div>
    <div>
      <label for="email" class="field-label">
        Имэйл хаяг <span class="field-req" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="200"
        autocomplete="email"
        class="field-input"
      />
    </div>
  </div>

  <!-- Honeypot: hidden from humans, bots tend to fill it -->
  <div class="hidden" aria-hidden="true">
    <label for="website">Вэбсайт</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <p
    id="form-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
    class="hidden form-status"
  >
  </p>

  <button
    type="submit"
    id="form-submit"
    class="btn-primary w-full sm:w-auto"
  >
    Хүсэлт илгээх
  </button>
</form>

<script>
  const form = document.getElementById('registration-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submit = document.getElementById('form-submit') as HTMLButtonElement | null;

  function showStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'form-status-ok', 'form-status-error');
    status.classList.add(ok ? 'form-status-ok' : 'form-status-error');
    // Bring the result into view for keyboard and screen-reader users
    status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    status.focus({ preventScroll: true });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (submit) submit.disabled = true;

    try {
      const res = await fetch('/api/register', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = (await res.json()) as { ok: boolean; error?: string };
      if (res.ok && data.ok) {
        form.reset();
        showStatus('Таны хүсэлтийг хүлээн авлаа. Бид тантай удахгүй холбогдох болно.', true);
      } else {
        showStatus(data.error ?? 'Алдаа гарлаа. Дахин оролдоно уу.', false);
      }
    } catch {
      showStatus('Сүлжээний алдаа гарлаа. Дахин оролдоно уу.', false);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

---
import { t } from '../lib/format';
import { localizePath, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { PageContent } from '../lib/types';

interface Props {
  page: PageContent | null;
}

const { page } = Astro.props;

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

// A club and a dancer are different audiences, not a primary and a fallback —
// so both cards carry equal weight. See docs/design-wdc.md §6 (Buttons).
const cards = [
  {
    href: localizePath('/register/club', lang),
    title: t(page?.clubCardTitle, lang) || s.clubCardTitle,
    text: t(page?.clubCardText, lang) || s.clubCardTextFallback,
  },
  {
    href: localizePath('/register/dancer', lang),
    title: t(page?.dancerCardTitle, lang) || s.dancerCardTitle,
    text: t(page?.dancerCardText, lang) || s.dancerCardTextFallback,
  },
];

const note = t(page?.registerNote, lang) || s.registerNoteFallback;
---

<div class="grid gap-s4 md:grid-cols-2">
  {
    cards.map((card) => (
      <a
        href={card.href}
        class="flex flex-col gap-s2 p-s6 bg-paper border border-line border-l-[3px] border-l-accent-500 rounded-flat hover:shadow-[0_2px_10px_rgb(0_0_0/0.07)] transition-shadow"
      >
        <h3 class="font-display text-head font-medium text-ink-800">{card.title}</h3>
        <p class="text-nav text-ink-600">{card.text}</p>
        <span class="mt-s2 inline-flex items-center gap-s1 text-nav font-bold uppercase tracking-[.04em] text-accent-700">
          {s.submitRequest}
        </span>
      </a>
    ))
  }
</div>
{note && <p class="mt-s4 text-nav text-ink-600 whitespace-pre-line">{note}</p>}

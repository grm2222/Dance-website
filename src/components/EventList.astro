---
import type { DanceEvent } from '../lib/types';

interface Props {
  events: DanceEvent[];
  emptyText?: string;
}

const { events, emptyText = 'Одоогоор мэдээлэл алга байна.' } = Astro.props;

function dateParts(iso: string): { day: string; month: string } {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return { day: '–', month: '' };
  return { day: String(d.getDate()), month: `${d.getMonth() + 1}-р сар` };
}
---

{
  events.length === 0 ? (
    <p class="text-body-500 text-sm">{emptyText}</p>
  ) : (
    <ol class="space-y-3">
      {events.map((event) => {
        const { day, month } = dateParts(event.date);
        return (
          <li class="flex items-center gap-4 rounded-xl border border-smoke-100 bg-white p-4 shadow-sm">
            <time
              datetime={event.date}
              class="shrink-0 grid h-16 w-16 place-content-center rounded-lg bg-theme-600 text-white text-center"
            >
              <span class="block text-2xl font-extrabold leading-none">{day}</span>
              <span class="block text-[11px] font-medium mt-1">{month}</span>
            </time>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold leading-snug text-dark-800">{event.title.mn}</h3>
              {event.location?.mn && (
                <p class="text-sm text-body-500 mt-0.5">{event.location.mn}</p>
              )}
              {event.description?.mn && (
                <p class="text-sm text-body-500 mt-1 line-clamp-2">{event.description.mn}</p>
              )}
              {event.type === 'result' && event.resultDetails?.mn && (
                <p class="text-sm text-dark-800 mt-1 whitespace-pre-line">{event.resultDetails.mn}</p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  )
}

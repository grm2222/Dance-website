---
import { dateParts, isToday, t } from '../lib/format';
import { localizePath, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { DanceEvent } from '../lib/types';

interface Props {
  events: DanceEvent[];
  emptyText?: string;
  /**
   * Where a result row links to. Pass an empty string on the results page
   * itself — a row that links to the page you are already on is noise.
   */
  resultHref?: string;
  /**
   * Homepage variant. The two lists sit side by side there, so rows must be a
   * uniform height or they stop lining up across the columns. Compact drops the
   * description and reserves a fixed two lines for the title, which makes every
   * row identical regardless of how long its content is.
   */
  compact?: boolean;
}

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const { events, emptyText, resultHref = '/calendar', compact = false } = Astro.props;
const empty = emptyText ?? s.noUpcoming;
const resultsLink = localizePath(resultHref, lang);
---

{
  events.length === 0 ? (
    <p class="text-nav text-ink-600">{empty}</p>
  ) : (
    <ol>
      {events.map((event, i) => {
        const { day, month } = dateParts(event.date, lang);
        const today = event.type === 'schedule' && isToday(event.date);
        const location = t(event.location, lang);
        const description = t(event.description, lang);
        return (
          <li
            class:list={[
              'flex flex-wrap sm:flex-nowrap items-stretch gap-s3 sm:gap-s4 py-s4 border-b border-line',
              i === 0 && 'border-t',
            ]}
          >
            <time
              datetime={event.date}
              class="shrink-0 h-[52px] w-[52px] sm:h-16 sm:w-16 grid place-content-center text-center leading-[1.1] bg-ink-900 text-white rounded-flat"
            >
              <span class="block font-display text-head sm:text-num font-medium">{day}</span>
              <span class="block text-meta uppercase tracking-[.06em] text-white/60 mt-s1">{month}</span>
            </time>

            <div class="flex-1 min-w-0 flex flex-col justify-center">
              <h3
                class:list={[
                  'font-display text-head font-medium text-ink-800 mb-s1',
                  // 2.7em = two lines at the 1.35 line-height below. Reserving the
                  // space keeps one- and two-line titles the same height.
                  compact && 'line-clamp-2 leading-[1.35] lg:min-h-[2.7em]',
                ]}
              >
                {t(event.title, lang)}
              </h3>
              {location && (
                <p class:list={['text-nav text-ink-600', compact && 'line-clamp-1']}>{location}</p>
              )}
              {!compact && description && (
                <p class="text-nav text-ink-600 line-clamp-2">{description}</p>
              )}
            </div>

            {/* Three-level status ladder in one hue — see docs/design-wdc.md §6.
                Results get link affordance, not a badge: they are a destination. */}
            <div class="shrink-0 self-center max-sm:self-start max-sm:ml-16 max-sm:w-full">
              {event.type === 'result' && resultHref ? (
                <a
                  href={resultsLink}
                  class="inline-flex items-center gap-s1 min-h-[var(--tap)] text-nav font-bold text-ink-800 whitespace-nowrap hover:text-accent-700 transition-colors"
                >
                  {s.viewResults}
                </a>
              ) : event.type === 'result' ? (
                <span class="inline-block px-s3 py-s1 rounded-flat border border-line-strong text-ink-600 text-meta font-bold uppercase tracking-[.06em] whitespace-nowrap">
                  {s.statusResult}
                </span>
              ) : today ? (
                <span class="inline-block px-s3 py-s1 rounded-flat bg-accent-700 text-white text-meta font-bold uppercase tracking-[.06em] whitespace-nowrap">
                  {s.statusToday}
                </span>
              ) : (
                <span class="inline-block px-s3 py-s1 rounded-flat border border-line-strong text-ink-600 text-meta font-bold uppercase tracking-[.06em] whitespace-nowrap">
                  {s.statusScheduled}
                </span>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  )
}

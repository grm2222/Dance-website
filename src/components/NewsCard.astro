---
import { urlFor } from '../lib/sanity';
import { formatDate } from '../lib/format';
import type { NewsArticlePreview } from '../lib/types';

interface Props {
  article: NewsArticlePreview;
}

const { article } = Astro.props;
const imageUrl = article.mainImage
  ? urlFor(article.mainImage).width(640).height(360).url()
  : null;
---

<article class="flex flex-col rounded-xl border border-smoke-100 bg-white shadow-sm overflow-hidden hover:shadow-md transition-shadow">
  <a href={`/news/${article.slug}`} class="block">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={article.mainImage?.alt ?? article.title.mn}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-cover"
        />
      ) : (
        <div aria-hidden="true" class="aspect-video w-full bg-smoke-100 grid place-items-center text-theme-600 font-bold text-2xl">
          Мэдээ
        </div>
      )
    }
  </a>
  <div class="flex flex-col flex-1 p-4">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-body-500 mb-2">
      <time datetime={article.publishedAt} class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V10h14v10ZM5 8V6h14v2H5Z" />
        </svg>
        {formatDate(article.publishedAt)}
      </time>
      {
        typeof article.viewCount === 'number' && (
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5Zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
            </svg>
            {article.viewCount}
          </span>
        )
      }
      {
        article.category && (
          <span class="rounded-full bg-theme-50 text-theme-700 px-2 py-0.5 font-medium">
            {article.category.title.mn}
          </span>
        )
      }
    </div>
    <h3 class="font-bold leading-snug line-clamp-2 text-dark-800">
      <a href={`/news/${article.slug}`} class="hover:text-theme-600">{article.title.mn}</a>
    </h3>
    <a
      href={`/news/${article.slug}`}
      class="mt-4 inline-block self-start rounded-md bg-theme-600 px-4 py-2 text-xs font-semibold text-white hover:bg-theme-700 transition-colors"
    >
      Дэлгэрэнгүй
    </a>
  </div>
</article>

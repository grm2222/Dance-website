---
import { t } from '../lib/format';
import { linkHref, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { CtaLink, SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;

const lang = toLang(Astro.currentLocale);
const s = strings(lang);

const siteName = t(settings?.siteName, lang) || s.siteNameFallback;
const footerText = t(settings?.footerText, lang);
const address = t(settings?.address, lang);
const year = new Date().getFullYear();

const FALLBACK_LINKS: CtaLink[] = [
  { label: { mn: 'Мэдээ', en: 'News' }, href: '/news' },
  { label: { mn: 'Хуанли', en: 'Calendar' }, href: '/calendar' },
  { label: { mn: 'Дүн', en: 'Results' }, href: '/results' },
  { label: { mn: 'Клуб бүртгүүлэх', en: 'Register a club' }, href: '/register/club' },
  { label: { mn: 'Тамирчин бүртгүүлэх', en: 'Register a dancer' }, href: '/register/dancer' },
];
const links = settings?.footerLinks?.length ? settings.footerLinks : FALLBACK_LINKS;

const socials = [
  { url: settings?.facebookUrl, label: 'Facebook', path: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z' },
  { url: settings?.instagramUrl, label: 'Instagram', path: 'M12 2c2.7 0 3 0 4.1.1 1.1 0 1.8.2 2.4.5.7.2 1.2.6 1.7 1.1s.9 1 1.1 1.7c.3.6.4 1.3.5 2.4C22 8.9 22 9.3 22 12s0 3.1-.1 4.2c0 1.1-.2 1.8-.5 2.4-.2.7-.6 1.2-1.1 1.7s-1 .9-1.7 1.1c-.6.3-1.3.4-2.4.5-1.1.1-1.4.1-4.2.1s-3.1 0-4.2-.1c-1.1 0-1.8-.2-2.4-.5-.7-.2-1.2-.6-1.7-1.1s-.9-1-1.1-1.7c-.3-.6-.4-1.3-.5-2.4C2 15.1 2 14.7 2 12s0-3.1.1-4.2c0-1.1.2-1.8.5-2.4.2-.7.6-1.2 1.1-1.7s1-.9 1.7-1.1c.6-.3 1.3-.4 2.4-.5C8.9 2 9.3 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm0 8.2a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4zM17.8 7.4a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z' },
  { url: settings?.youtubeUrl, label: 'YouTube', path: 'M21.6 7.2s-.2-1.4-.8-2c-.7-.8-1.5-.8-1.9-.8C16.2 4.2 12 4.2 12 4.2s-4.2 0-6.9.2c-.4 0-1.2 0-1.9.8-.6.6-.8 2-.8 2S2.2 8.8 2.2 10.5v1.6c0 1.6.2 3.3.2 3.3s.2 1.4.8 2c.7.8 1.7.7 2.1.8 1.5.2 6.7.2 6.7.2s4.2 0 6.9-.2c.4 0 1.2 0 1.9-.8.6-.6.8-2 .8-2s.2-1.6.2-3.3v-1.6c0-1.7-.2-3.3-.2-3.3zM9.9 14.3V8.6l5.4 2.9-5.4 2.8z' },
].filter((x): x is { url: string; label: string; path: string } => Boolean(x.url));
---

<footer class="bg-ink-900 text-white/70 pt-s12 text-nav">
  <div class="mx-auto max-w-page px-s4">
    <div class="grid gap-s8 md:grid-cols-[2fr_1fr_1fr] md:gap-s12">
      <div>
        <h2 class="text-nav font-bold uppercase tracking-[.06em] text-white pb-s2 border-b-[3px] border-accent-500 inline-block mb-s4">
          {s.aboutUs}
        </h2>
        {footerText && <p class="mb-s3 leading-[1.7] whitespace-pre-line">{footerText}</p>}
        {
          settings?.emails?.map((mail) => (
            <p class="mb-s3">
              <a href={`mailto:${mail}`} class="tap inline-block text-white hover:underline">{mail}</a>
            </p>
          ))
        }
        {settings?.phone && (
          <p class="mb-s3"><a href={`tel:${settings.phone}`} class="tap inline-block text-white hover:underline">{settings.phone}</a></p>
        )}
        {address && <p class="mb-s3 whitespace-pre-line">{address}</p>}
      </div>

      <div>
        <h2 class="text-nav font-bold uppercase tracking-[.06em] text-white pb-s2 border-b-[3px] border-accent-500 inline-block mb-s4">
          {s.footerLinks}
        </h2>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={linkHref(link, lang)} class="flex items-center min-h-[var(--tap)] hover:text-white transition-colors">
                  {t(link.label, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        socials.length > 0 && (
          <div>
            <h2 class="text-nav font-bold uppercase tracking-[.06em] text-white pb-s2 border-b-[3px] border-accent-500 inline-block mb-s4">
              {s.footerFollow}
            </h2>
            <div class="flex gap-s3">
              {socials.map((social) => (
                <a
                  href={social.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={social.label}
                  class="grid h-[var(--tap)] w-[var(--tap)] place-items-center rounded-flat bg-white/[.08] hover:bg-accent-700 hover:text-white transition-colors"
                >
                  <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true"><path d={social.path} /></svg>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="mt-s12 border-t border-white/10">
    <p class="mx-auto max-w-page px-s4 py-s4 text-nav text-white/55">
      © {year} {siteName}. {s.rightsReserved}
    </p>
  </div>
</footer>

---
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const siteName = settings?.siteName?.mn ?? 'Монголын Чөлөөт Бүжгийн Холбоо';
const year = new Date().getFullYear();
---

<footer class="bg-dark-800 text-white/70">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <h2 class="text-white font-bold mb-3">{siteName}</h2>
      {settings?.footerText?.mn && <p class="text-sm leading-relaxed">{settings.footerText.mn}</p>}
    </div>

    <div>
      <h2 class="text-white font-bold mb-3">Холбоо барих</h2>
      <ul class="space-y-2 text-sm">
        {
          settings?.phone && (
            <li>
              <a href={`tel:${settings.phone}`} class="hover:text-white">
                Утас: {settings.phone}
              </a>
            </li>
          )
        }
        {
          settings?.emails?.map((email) => (
            <li>
              <a href={`mailto:${email}`} class="hover:text-white">
                {email}
              </a>
            </li>
          ))
        }
        {settings?.address?.mn && <li>{settings.address.mn}</li>}
      </ul>
    </div>

    <div>
      <h2 class="text-white font-bold mb-3">Холбоосууд</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/news" class="hover:text-white">Мэдээ мэдээлэл</a></li>
        <li><a href="/register" class="hover:text-white">Бүртгүүлэх хүсэлт</a></li>
        {
          settings?.facebookUrl && (
            <li>
              <a href={settings.facebookUrl} rel="noopener noreferrer" target="_blank" class="hover:text-white">
                Facebook хуудас
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-white/50">
      © {year} {siteName}. Бүх эрх хуулиар хамгаалагдсан.
    </p>
  </div>
</footer>

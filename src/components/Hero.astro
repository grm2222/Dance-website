---
import { urlFor } from '../lib/sanity';
import { t } from '../lib/format';
import { localizePath, toLang } from '../lib/i18n';
import { strings } from '../lib/ui';
import type { PageContent } from '../lib/types';

interface Props {
  page: PageContent | null;
}

const { page } = Astro.props;

const lang = toLang(Astro.currentLocale);
const s = strings(lang);
const href = (target: string) => (target.startsWith('/') ? localizePath(target, lang) : target);

const eyebrow = t(page?.heroEyebrow, lang);
const title = t(page?.heroTitle, lang) || s.heroTitleFallback;
const subtitle = t(page?.heroSubtitle, lang) || s.heroSubtitleFallback;

const heroImageUrl = page?.heroImage
  ? urlFor(page.heroImage).width(1920).height(1000).url()
  : null;

const primary = page?.heroPrimaryCta;
const secondary = page?.heroSecondaryCta;
const primaryLabel = t(primary?.label, lang) || s.heroPrimaryFallback;
const primaryHref = href(primary?.href || '/register');
const secondaryLabel = t(secondary?.label, lang) || s.heroSecondaryFallback;
const secondaryHref = href(secondary?.href || '/calendar');
---

<section class="relative isolate bg-ink-900 text-white overflow-hidden">
  {
    heroImageUrl && (
      <img
        src={heroImageUrl}
        alt=""
        width="1920"
        height="1000"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
    )
  }
  <!-- Left-to-right scrim keeps the headline legible over any photo. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(0_0_0/.88)_0%,rgb(0_0_0/.72)_45%,rgb(0_0_0/.35)_100%)]"
  >
  </div>

  <div class="mx-auto max-w-page px-s4 py-s12 md:py-s18">
    <!-- Left-aligned, matching the rest of the page — a centred hero breaks the axis. -->
    <div class="max-w-[660px]">
      {
        eyebrow && (
          <span class="inline-block text-meta font-bold tracking-[.14em] uppercase bg-white/[.14] px-s3 py-s1 rounded-flat mb-s6">
            {eyebrow}
          </span>
        )
      }
      <h1 class="font-display text-section md:text-hero font-normal leading-[1.15] mb-s4">
        {title}
      </h1>
      <p class="text-white/80 mb-s8 max-w-[52ch] whitespace-pre-line">{subtitle}</p>
      <div class="flex flex-wrap gap-s3">
        <a
          href={primaryHref}
          class="inline-flex items-center justify-center min-h-[var(--tap)] px-s6 py-s3 rounded-flat bg-accent-700 text-white text-nav font-bold uppercase tracking-[.04em] hover:bg-accent-800 transition-colors"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex items-center justify-center min-h-[var(--tap)] px-s6 py-s3 rounded-flat bg-white text-ink-900 text-nav font-bold uppercase tracking-[.04em] hover:bg-white/85 transition-colors"
        >
          {secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>

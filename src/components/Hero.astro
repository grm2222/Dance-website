---
import { urlFor } from '../lib/sanity';
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings | null;
}

const { settings } = Astro.props;
const title = settings?.heroTitle?.mn ?? 'Монголын Чөлөөт';
const accent = settings?.heroTitleAccent?.mn ?? 'Бүжгийн Холбоо';
const subtitle =
  settings?.heroSubtitle?.mn ??
  'Спорт бүжгийн тэмцээн, сургалт, мэдээ мэдээллийн нэгдсэн төв';
const heroImageUrl = settings?.heroImage
  ? urlFor(settings.heroImage).width(1600).height(900).url()
  : null;
---

<section class="relative bg-dark-800 text-white overflow-hidden">
  {
    heroImageUrl && (
      <img
        src={heroImageUrl}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-40"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <!-- angled accent shape, echoing the reference hero_shape svg -->
  <div
    aria-hidden="true"
    class="absolute -left-24 top-0 h-full w-64 bg-theme-600/20 hidden lg:block"
    style="transform: skewX(-12deg);"
  >
  </div>
  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight uppercase leading-tight text-balance">
      {title}
      {accent && <span class="block text-theme-600">{accent}</span>}
    </h1>
    <p class="mt-5 text-base sm:text-lg text-white/80 max-w-2xl">{subtitle}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a
        href="/register"
        class="inline-block rounded-md bg-theme-600 text-white text-center font-semibold px-7 py-3.5 hover:bg-theme-700 transition-colors"
      >
        Гишүүнээр бүртгүүлэх
      </a>
      <a
        href="/news"
        class="inline-block rounded-md border border-white/40 text-center font-semibold px-7 py-3.5 hover:bg-white/10 transition-colors"
      >
        Дэлгэрэнгүй
      </a>
    </div>
  </div>
</section>

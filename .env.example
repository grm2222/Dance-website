# Sanity project (find at https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Admin panel URL for the header "Нэвтрэх" link
# (after `cd studio && npx sanity deploy`, e.g. https://dancesport-mn.sanity.studio)
PUBLIC_STUDIO_URL=http://localhost:3333

# Server-only token with write access — used by /api/register to create
# registrationRequest documents. Never expose client-side.
SANITY_WRITE_TOKEN=

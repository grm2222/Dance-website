# Sanity project (find at https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Admin panel URL for the header "Нэвтрэх" link
# (after `cd studio && npx sanity deploy`, e.g. https://dancesport-mn.sanity.studio)
PUBLIC_STUDIO_URL=http://localhost:3333

# Secret shared with the Sanity "publish" webhook. It authenticates the call to
# /api/revalidate and is also the Vercel ISR bypass token, so publishing
# refreshes the affected pages immediately. Generate with:
#   node -p "require('crypto').randomBytes(24).toString('base64url')"
ISR_BYPASS_TOKEN=

# Server-only token with write access — used by /api/register to create
# registrationRequest documents. Never expose client-side.
SANITY_WRITE_TOKEN=
